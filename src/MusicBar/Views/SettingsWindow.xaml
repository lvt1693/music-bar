<Window x:Class="MusicBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MusicBar.Views"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        Title="{l:Tr Set_Title}"
        Width="980" Height="720" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ThemeMode="Dark"
        Icon="pack://application:,,,/Assets/MusicBar.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" />

        <Style TargetType="v:SettingCard">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="v:SettingCard">
                        <Border Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="7"
                                Padding="16,11" MinHeight="66">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource Icons}" FontSize="18"
                                           Margin="2,0,18,0" VerticalAlignment="Center" Opacity="0.92" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" FontSize="12"
                                               Opacity="0.62" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <!-- The switch takes its name from the card's header, as a sighted user reads it. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Label" Text="{l:Tr Set_Off}" Width="30" Margin="0,0,10,0" TextAlignment="Right"
                                       VerticalAlignment="Center" Opacity="0.6" />
                            <Grid Width="40" Height="20">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="#A0FFFFFF"
                                        Background="#0AFFFFFF" />
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#E0FFFFFF"
                                         HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF111111" />
                                <Setter TargetName="Label" Property="Text" Value="{l:Tr Set_On}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="Label" Property="Opacity" Value="1" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation entries -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="38">
                            <Border x:Name="Bg" CornerRadius="5" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{StaticResource Accent}" Opacity="0" />
                            <ContentPresenter Margin="14,0,8,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#16FFFFFF" />
                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
            <!-- Tag holds the color; its text (a hex value) is the best name a swatch has. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Opacity="0" Margin="-3" />
                            <Ellipse Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Navigation ============ -->
        <Grid Margin="14,14,4,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="8,4,0,22">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/MusicBar.ico" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MusicBar" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" FontSize="11.5" Opacity="0.55" />
                    </StackPanel>
                </StackPanel>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="12,0,0,0" DisplayMemberPath="Label" SelectedValuePath="Value"
                              ItemsSource="{x:Static v:SettingsOptions.Languages}" SelectedValue="{Binding Language}"
                              ToolTip="{l:Tr Set_Language}" AutomationProperties.Name="{l:Tr Set_Language}" />
                </Grid>
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- One page per thing on the taskbar, in the order SettingsWindow._pages lists them. -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_General}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_Bar}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_Player}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76E;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_Face}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_Progress}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE719;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_Gallery}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_Lyrics}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Set_Page_About}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Now playing -->
            <Border Grid.Row="2" CornerRadius="10" Padding="10" Background="#0FFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="8" Background="#1AFFFFFF">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="16" Opacity="0.6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush x:Name="NowArt" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr Set_NowPlaying}" FontSize="10" FontWeight="SemiBold" Opacity="0.5" />
                        <TextBlock x:Name="NowTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NowArtist" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Pages, with the sponsor's banner under them ============ -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="AdBand" Grid.Row="1" Margin="30,6,34,16" CornerRadius="12" Cursor="Hand" Visibility="Collapsed"
                Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" MaxHeight="130" MouseLeftButtonUp="AdBand_Click">
            <Grid>
                <Image x:Name="AdImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2" CornerRadius="6" Background="#99000000">
                    <TextBlock Text="{l:Tr Set_Ad_Label}" FontSize="10.5" Foreground="#E6FFFFFF" />
                </Border>
                <StackPanel x:Name="AdDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" />
            </Grid>
        </Border>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="30,22,34,30">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- General -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="{l:Tr Set_Page_General}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_General_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="{l:Tr Set_General_GroupWhen}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE7E8;" Header="{l:Tr Set_StartWithWindows}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE7ED;" Header="{l:Tr Set_HideIdle}"
                                   Description="{l:Tr Set_HideIdle_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideWhenIdle}" />
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_General_GroupSource}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE767;" Header="{l:Tr Set_Source}"
                                   Description="{l:Tr Set_Source_Desc}">
                        <ComboBox x:Name="SourceCombo" MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding PinnedAppId}" DropDownOpened="SourceCombo_DropDownOpened"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <!-- VLC 3 publishes no media session: read through its web interface, once switched on there. -->
                    <StackPanel x:Name="VlcPanel" Visibility="Collapsed">
                        <v:SettingCard Glyph="&#xE8B2;" Header="{l:Tr Set_Vlc}" Description="{l:Tr Set_Vlc_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ReadVlc}" Click="Vlc_Click" />
                        </v:SettingCard>
                        <TextBlock x:Name="VlcStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="54,-2,0,10" Visibility="Collapsed" />
                    </StackPanel>

                    <TextBlock Text="{l:Tr Set_Bar_GroupScreens}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE7F4;" Header="{l:Tr Set_DisplayTarget}" Description="{l:Tr Set_DisplayTarget_Desc}">
                        <ComboBox x:Name="DisplayCombo" MinWidth="260" DisplayMemberPath="Label"
                                  SelectionChanged="DisplayCombo_Changed" DropDownOpened="DisplayCombo_DropDownOpened"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE768;" Header="{l:Tr Set_PlayerTarget}" Description="{l:Tr Set_PlayerTarget_Desc}">
                        <ComboBox x:Name="PlayerScreenCombo" MinWidth="260" DisplayMemberPath="Label"
                                  SelectionChanged="PlayerScreenCombo_Changed" DropDownOpened="DisplayCombo_DropDownOpened"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE945;" Header="{l:Tr Set_HardwareAccel}" Description="{l:Tr Set_HardwareAccel_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HardwareAcceleration}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE7F8;" Header="{l:Tr Set_SkinRenderer}" Description="{l:Tr Set_SkinRenderer_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value" IsEnabled="{Binding HardwareAcceleration}"
                                  ItemsSource="{x:Static v:SettingsOptions.SkinRenderers}" SelectedValue="{Binding SkinRenderer}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                </StackPanel>

                <!-- Taskbar -->
                <StackPanel x:Name="PageBar" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_Bar}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_Bar_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="{l:Tr Set_Bar_GroupBackground}" Style="{StaticResource Group}" />
                    <v:SettingCard x:Name="TransparentCard" Glyph="&#xE81E;" Header="{l:Tr Set_Transparent}"
                                   Description="{l:Tr Set_Transparent_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TransparentTaskbar}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE771;" Header="{l:Tr Set_Background}" Description="{l:Tr Set_Background_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value" ItemsSource="{x:Static v:SettingsOptions.Backgrounds}"
                                  SelectedValue="{Binding Background}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE793;" Header="{l:Tr Set_MatchWindowsMode}" Description="{l:Tr Set_MatchWindowsMode_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MatchWindowsMode}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE706;" Header="{l:Tr Set_BgOpacity}" Description="{l:Tr Set_BgOpacity_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                                    Value="{Binding BackgroundOpacity}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE81E;" Header="{l:Tr Set_LayerMode}"
                                   Description="{l:Tr Set_LayerMode_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ItemsSource="{x:Static v:SettingsOptions.LayerModes}" SelectedValue="{Binding LayerMode}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <TextBlock x:Name="LayerStatusText" FontSize="12" Opacity="0.55" Margin="18,-2,0,8" />

                    <TextBlock Text="{l:Tr Set_Bar_GroupWindows}" Style="{StaticResource Group}" />
                    <v:SettingCard x:Name="TaskbarSizeCard" Glyph="&#xE740;" Header="{l:Tr Set_TaskbarSize}"
                                   Description="{l:Tr Set_TaskbarSize_Desc}">
                        <ComboBox x:Name="TaskbarSizeCombo" MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ItemsSource="{x:Static v:SettingsOptions.TaskbarSizes}" SelectionChanged="TaskbarSize_Changed"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8E3;" Header="{l:Tr Set_Center}"
                                   Description="{l:Tr Set_Center_Desc}">
                        <CheckBox x:Name="TaskbarCenterSwitch" Style="{StaticResource Switch}"
                                  Checked="TaskbarCenter_Changed" Unchecked="TaskbarCenter_Changed" />
                    </v:SettingCard>
                    <Border x:Name="TaskbarNotice" CornerRadius="7" Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                            Padding="16,10" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TaskbarStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="SwitchTaskbarButton" Content="{l:Tr Set_UseExplorerPatcher}" Padding="14,5"
                                        Margin="0,0,0,6" Click="SwitchTaskbar_Click" HorizontalAlignment="Stretch" />
                                <Button x:Name="RestartExplorerButton" Content="{l:Tr Set_RestartExplorer}" Padding="14,5"
                                        Click="RestartExplorer_Click" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{l:Tr Set_Bar_GroupTray}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE91C;" Header="{l:Tr Set_ControlCenter}"
                                   Description="{l:Tr Set_ControlCenter_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ControlCenter}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE92E;" Header="{l:Tr Set_WinA}" Description="{l:Tr Set_WinA_Desc}"
                                   IsEnabled="{Binding ControlCenter}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WinAOpensControlCenter}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xEA8F;" Header="{l:Tr Set_NotificationDot}" Description="{l:Tr Set_NotificationDot_Desc}"
                                   IsEnabled="{Binding ControlCenter}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotificationDot}" />
                    </v:SettingCard>
                </StackPanel>

                <!-- Player -->
                <StackPanel x:Name="PagePlayer" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_Player}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_Player_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <v:SettingCard Glyph="&#xE768;" Header="{l:Tr Set_PlayerMode}" Description="{l:Tr Set_PlayerMode_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ItemsSource="{x:Static v:SettingsOptions.PlayerModes}" SelectedValue="{Binding PlayerMode}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>

                    <!-- Everything below shapes the player, so it rests while the player is hidden. -->
                    <StackPanel x:Name="PlayerParts">
                        <TextBlock Text="{l:Tr Set_Player_GroupPlace}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE737;" Header="{l:Tr Set_WidgetPlacement}" Description="{l:Tr Set_WidgetPlacement_Desc}">
                            <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ItemsSource="{x:Static v:SettingsOptions.Placements}" SelectedValue="{Binding WidgetPlacement}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </v:SettingCard>

                        <TextBlock Text="{l:Tr Set_Player_GroupParts}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE91B;" Header="{l:Tr Set_AlbumArt}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowAlbumArt}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE71D;" Header="{l:Tr Set_AppIcon}" Description="{l:Tr Set_AppIcon_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowAppIcon}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE768;" Header="{l:Tr Set_Controls}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowControls}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE790;" Header="{l:Tr Set_ControlStyle}" Description="{l:Tr Set_ControlStyle_Desc}">
                            <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ItemsSource="{x:Static v:SettingsOptions.ControlStyles}" SelectedValue="{Binding ControlStyle}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </v:SettingCard>
                        <TextBlock Text="{l:Tr Set_Player_GroupCard}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE946;" Header="{l:Tr Set_InfoPopup}"
                                       Description="{l:Tr Set_InfoPopup_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowInfoPopup}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE774;" Header="{l:Tr Set_OnlineInfo}"
                                       Description="{l:Tr Set_OnlineInfo_Desc}" IsEnabled="{Binding ShowInfoPopup}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnlineTrackInfo}" />
                        </v:SettingCard>
                    </StackPanel>
                </StackPanel>

                <!-- Face -->
                <StackPanel x:Name="PageFace" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_Face}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_Face_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <v:SettingCard Glyph="&#xE76E;" Header="{l:Tr Set_FaceEnabled}" Description="{l:Tr Set_FaceEnabled_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceEnabled}" />
                    </v:SettingCard>

                    <StackPanel IsEnabled="{Binding FaceEnabled}">
                        <TextBlock Text="{l:Tr Set_Face_GroupStyle}" Style="{StaticResource Group}" />
                        <TextBlock Text="{l:Tr Set_Face_StyleHint}" FontSize="12" Opacity="0.6" Margin="2,-4,0,10" />
                        <WrapPanel x:Name="FaceGallery" Margin="0,0,-10,6" />

                        <!-- The face of pictures: one for each mood; only Idle is needed. -->
                        <StackPanel x:Name="FacePictures" Visibility="Collapsed">
                            <TextBlock Text="{l:Tr Set_Face_GroupPictures}" Style="{StaticResource Group}" />
                            <TextBlock Text="{l:Tr Set_Face_PicturesHint}" FontSize="12" Opacity="0.6" Margin="2,-4,0,10" TextWrapping="Wrap" />
                            <WrapPanel x:Name="FaceStates" Margin="0,0,-10,4" />
                            <TextBlock x:Name="FacePicStatus" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="2,0,0,8" Visibility="Collapsed" />
                            <Button Content="{l:Tr Set_Face_OpenFolder}" Padding="14,5" HorizontalAlignment="Left" Margin="0,0,0,8" Click="FaceFolder_Click" />
                        </StackPanel>

                        <TextBlock Text="{l:Tr Set_Face_GroupPlace}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE737;" Header="{l:Tr Set_FacePlacement}" Description="{l:Tr Set_FacePlacement_Desc}">
                            <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ItemsSource="{x:Static v:SettingsOptions.FacePlacements}" SelectedValue="{Binding FacePlacement}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE740;" Header="{l:Tr Set_FaceScale}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="220" Minimum="0.6" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                        Value="{Binding FaceScale}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                                <TextBlock Style="{StaticResource Value}" Text="{Binding FaceScale, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE7ED;" Header="{l:Tr Set_FaceStaysIdle}" Description="{l:Tr Set_FaceStaysIdle_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceStaysWhenIdle}" />
                        </v:SettingCard>

                        <TextBlock Text="{l:Tr Set_Face_GroupMood}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE823;" Header="{l:Tr Set_FaceClock}" Description="{l:Tr Set_FaceClock_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceFollowsClock}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE8D6;" Header="{l:Tr Set_FaceMusic}" Description="{l:Tr Set_FaceMusic_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceReactsToMusic}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE962;" Header="{l:Tr Set_FacePointer}" Description="{l:Tr Set_FacePointer_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceWatchesPointer}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE7F4;" Header="{l:Tr Set_FaceSystem}" Description="{l:Tr Set_FaceSystem_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceReactsToSystem}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE805;" Header="{l:Tr Set_FaceStroll}" Description="{l:Tr Set_FaceStroll_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceStrolls}" />
                        </v:SettingCard>

                        <TextBlock Text="{l:Tr Set_Face_GroupWear}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE7BE;" Header="{l:Tr Set_FaceHat}" Description="{l:Tr Set_FaceHat_Desc}">
                            <ComboBox MinWidth="200" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ItemsSource="{x:Static v:SettingsOptions.FaceHats}" SelectedValue="{Binding FaceHat}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE7B3;" Header="{l:Tr Set_FaceGlasses}">
                            <ComboBox MinWidth="200" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      ItemsSource="{x:Static v:SettingsOptions.FaceGlasses}" SelectedValue="{Binding FaceGlasses}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE7F6;" Header="{l:Tr Set_FaceHeadphones}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceHeadphones}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE720;" Header="{l:Tr Set_FaceMic}" Description="{l:Tr Set_FaceMic_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceHoldsMic}" />
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE787;" Header="{l:Tr Set_FaceSeasonal}" Description="{l:Tr Set_FaceSeasonal_Desc}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FaceSeasonal}" />
                        </v:SettingCard>

                        <TextBlock Text="{l:Tr Set_Face_GroupFocus}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE916;" Header="{l:Tr Set_FocusMinutes}" Description="{l:Tr Set_FocusMinutes_Desc}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="220" Minimum="5" Maximum="90" SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding FocusMinutes}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                                <TextBlock Style="{StaticResource Value}"><Run Text="{Binding FocusMinutes, Mode=OneWay}" /> <Run Text="{l:Tr Set_MinutesUnit}" /></TextBlock>
                            </StackPanel>
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE76E;" Header="{l:Tr Set_BreakMinutes}" Description="{l:Tr Set_BreakMinutes_Desc}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="220" Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding BreakMinutes}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                                <TextBlock Style="{StaticResource Value}"><Run Text="{Binding BreakMinutes, Mode=OneWay}" /> <Run Text="{l:Tr Set_MinutesUnit}" /></TextBlock>
                            </StackPanel>
                        </v:SettingCard>
                        <v:SettingCard Glyph="&#xE768;" Header="{l:Tr Set_FocusStart}" Description="{l:Tr Set_FocusStart_Desc}">
                            <Button x:Name="FocusButton" Padding="14,5" Click="Focus_Click" />
                        </v:SettingCard>

                        <TextBlock Text="{l:Tr Set_Face_GroupPlay}" Style="{StaticResource Group}" />
                        <v:SettingCard Glyph="&#xE815;" Header="{l:Tr Set_Face_Poke}" Description="{l:Tr Set_Face_Poke_Desc}" />
                        <v:SettingCard Glyph="&#xE7C9;" Header="{l:Tr Set_Face_Rub}" Description="{l:Tr Set_Face_Rub_Desc}" />
                        <v:SettingCard Glyph="&#xE8B5;" Header="{l:Tr Set_Face_More}" Description="{l:Tr Set_Face_More_Desc}" />
                    </StackPanel>
                </StackPanel>

                <!-- Progress bar -->
                <StackPanel x:Name="PageProgress" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_Progress}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_Progress_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <!-- The looks: one group at a time in small live tiles, the one under the pointer described below them. -->
                    <TextBlock Text="{l:Tr Set_Progress_GroupStyle}" Style="{StaticResource Group}" />
                    <Grid Margin="0,-2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="3" Background="#0DFFFFFF">
                            <StackPanel x:Name="LookTabs" Orientation="Horizontal" />
                        </Border>
                        <!-- Search every style, visualizer, LED strip and skin by name, description or author. -->
                        <Grid Grid.Column="2" Width="230" VerticalAlignment="Center">
                            <TextBox x:Name="LookSearch" Padding="26,5,8,5" TextChanged="LookSearch_TextChanged" KeyDown="LookSearch_KeyDown"
                                     AutomationProperties.Name="{l:Tr Set_Look_Search}" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Opacity="0.5" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="LookSearchHint" Text="{l:Tr Set_Look_Search}" FontSize="12.5" Opacity="0.45" Margin="29,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="LookHint" FontSize="12" Opacity="0.6" Margin="2,0,0,10" TextWrapping="Wrap" />
                    <UniformGrid x:Name="SeekGallery" Columns="4" Margin="0,0,-8,0" />
                    <UniformGrid x:Name="VisualizerGallery" Columns="4" Margin="0,0,-8,0" Visibility="Collapsed" />
                    <UniformGrid x:Name="LedGallery" Columns="4" Margin="0,0,-8,0" Visibility="Collapsed" />
                    <StackPanel x:Name="SkinPane" Visibility="Collapsed">
                        <UniformGrid x:Name="SkinGallery" Columns="4" Margin="0,0,-8,0" />
                        <TextBlock x:Name="SkinEmpty" Text="{l:Tr Set_Skin_None}" FontSize="12" Opacity="0.55" Margin="2,0,0,8" Visibility="Collapsed" />
                        <WrapPanel Margin="0,2,0,2">
                            <Button Content="{l:Tr Set_Skin_Import}" Padding="14,5" Margin="0,0,8,6" Click="SkinImport_Click" />
                            <Button Content="{l:Tr Set_Skin_Samples}" Padding="14,5" Margin="0,0,8,6" Click="SkinSamples_Click" />
                            <Button Content="{l:Tr Set_Skin_Folder}" Padding="14,5" Margin="0,0,8,6" Click="SkinFolder_Click" />
                            <Button Content="{l:Tr Set_Skin_Guide}" Padding="14,5" Margin="0,0,8,6" Click="SkinGuide_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SkinStatus" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="2,0,0,8" Visibility="Collapsed" />
                        <Button x:Name="SkinCopyError" Content="{l:Tr Set_Skin_CopyError}" HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,8" Visibility="Collapsed" Click="SkinCopyError_Click" />
                    </StackPanel>
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Background="#0AFFFFFF">
                        <TextBlock x:Name="LookDetail" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Colors for the look that's on: the song's, a preset, or three picked by hand. -->
                    <v:SettingCard Glyph="&#xE790;" Header="{l:Tr Set_Palette}" Description="{l:Tr Set_Palette_Desc}">
                        <TextBlock x:Name="PaletteFor" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                    </v:SettingCard>
                    <WrapPanel x:Name="PaletteChips" Margin="4,-2,-10,4" />
                    <StackPanel x:Name="CustomPalette" Orientation="Horizontal" Margin="6,2,0,12" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr Pal_CustomHint}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="PaletteA" Width="86" Margin="0,0,6,0" KeyDown="PaletteBox_KeyDown" LostFocus="PaletteBox_LostFocus"
                                 AutomationProperties.Name="{l:Tr A11y_Palette1}" />
                        <TextBox x:Name="PaletteB" Width="86" Margin="0,0,6,0" KeyDown="PaletteBox_KeyDown" LostFocus="PaletteBox_LostFocus"
                                 AutomationProperties.Name="{l:Tr A11y_Palette2}" />
                        <TextBox x:Name="PaletteC" Width="86" KeyDown="PaletteBox_KeyDown" LostFocus="PaletteBox_LostFocus"
                                 AutomationProperties.Name="{l:Tr A11y_Palette3}" />
                    </StackPanel>

                    <TextBlock Text="{l:Tr Set_Progress_GroupMotion}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE8AB;" Header="{l:Tr Set_SeekDirection}" Description="{l:Tr Set_SeekDirection_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ItemsSource="{x:Static v:SettingsOptions.SeekDirections}" SelectedValue="{Binding SeekDirection}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE7C4;" Header="{l:Tr Set_AvoidIcons}" Description="{l:Tr Set_AvoidIcons_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SeekAvoidIcons}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE793;" Header="{l:Tr Set_FillOpacity}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="0.08" Maximum="0.9" SmallChange="0.02" LargeChange="0.1"
                                    Value="{Binding FillOpacity}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding FillOpacity, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE768;" Header="{l:Tr Set_IdleMotion}" Description="{l:Tr Set_IdleMotion_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SeekIdleMotion}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE995;" Header="{l:Tr Set_AudioReactive}"
                                   Description="{l:Tr Set_AudioReactive_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AudioReactive}" />
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_Progress_GroupColor}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE790;" Header="{l:Tr Set_Accent}"
                                   Description="{l:Tr Set_Accent_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value" ItemsSource="{x:Static v:SettingsOptions.AccentSources}"
                                  SelectedValue="{Binding AccentSource}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE2B1;" Header="{l:Tr Set_CustomColor}" Description="{l:Tr Set_CustomColor_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{x:Static v:SettingsOptions.Swatches}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Swatch}" Background="{Binding}" Tag="{Binding}"
                                                Click="Swatch_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="HexBox" Width="92" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Text="{Binding CustomColor, UpdateSourceTrigger=LostFocus}" KeyDown="HexBox_KeyDown"
                                     AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </StackPanel>
                    </v:SettingCard>
                </StackPanel>

                <!-- The online gallery: what others made, what was downloaded, sharing one's own. -->
                <StackPanel x:Name="PageGallery" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_Gallery}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_Gal_Subtitle}" Style="{StaticResource PageSubtitle}" />
                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="3" Margin="0,2,0,10" Background="#0DFFFFFF">
                        <StackPanel x:Name="GalleryTabs" Orientation="Horizontal" />
                    </Border>
                    <TextBlock x:Name="GalleryStatus" FontSize="12" Opacity="0.7" Margin="2,0,0,10" TextWrapping="Wrap" />
                    <UniformGrid x:Name="GalleryGrid" Columns="3" Margin="0,0,-8,0" />
                    <WrapPanel Margin="0,4,0,6">
                        <Button x:Name="GalleryMore" Content="{l:Tr Set_Gal_More}" Padding="14,5" Margin="0,0,8,6" Click="GalleryMore_Click" Visibility="Collapsed" />
                        <Button Content="{l:Tr Set_Gal_Refresh}" Padding="14,5" Margin="0,0,8,6" Click="GalleryRefresh_Click" />
                        <Button Content="{l:Tr Set_Gal_Web}" Padding="14,5" Margin="0,0,8,6" Click="GalleryWeb_Click" />
                    </WrapPanel>

                    <TextBlock Text="{l:Tr Set_Gal_GroupMine}" Style="{StaticResource Group}" />
                    <TextBlock x:Name="PresetsEmpty" Text="{l:Tr Set_Gal_NoPresets}" FontSize="12" Opacity="0.55" Margin="2,0,0,8" TextWrapping="Wrap" />
                    <UniformGrid x:Name="PresetGrid" Columns="4" Margin="0,0,-8,0" />

                    <!-- Sharing finishes in the browser with a Google account, whose display name the gallery shows: no nickname here. -->
                    <TextBlock Text="{l:Tr Set_Gal_GroupShare}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE898;" Header="{l:Tr Set_Gal_Share}" Description="{l:Tr Set_Gal_Share_Desc}">
                        <ComboBox x:Name="ShareWhat" MinWidth="260" DisplayMemberPath="Label"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <Grid Margin="4,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Set_Gal_ShareName}" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <TextBox x:Name="ShareName" MaxLength="40" AutomationProperties.Name="{l:Tr Set_Gal_ShareName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="{l:Tr Set_Gal_ShareDesc}" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                            <TextBox x:Name="ShareDesc" MaxLength="300" AutomationProperties.Name="{l:Tr Set_Gal_ShareDesc}" />
                        </StackPanel>
                        <Button x:Name="ShareButton" Grid.Column="2" VerticalAlignment="Bottom" Content="{l:Tr Set_Gal_ShareSend}" Padding="16,5" Click="Share_Click" />
                    </Grid>
                    <TextBlock x:Name="ShareStatus" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="4,4,0,8" Visibility="Collapsed" />
                </StackPanel>

                <!-- Lyrics -->
                <StackPanel x:Name="PageLyrics" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_Lyrics}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_Lyr_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="{l:Tr Set_Lyr_GroupPlace}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE8FD;" Header="{l:Tr Set_LyricsExpanded}"
                                   Description="{l:Tr Set_LyricsExpanded_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LyricsExpanded}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8A1;" Header="{l:Tr Set_LyricsPlacement}"
                                   Description="{l:Tr Set_LyricsPlacement_Desc}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ItemsSource="{x:Static v:SettingsOptions.LyricsPlacements}" SelectedValue="{Binding LyricsPlacement}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE740;" Header="{l:Tr Set_WidgetMaxWidth}" Description="{l:Tr Set_WidgetMaxWidth_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="240" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True"
                                    Value="{Binding WidgetMaxWidth}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding WidgetMaxWidth, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8E3;" Header="{l:Tr Set_LyricsAlign}">
                        <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value" ItemsSource="{x:Static v:SettingsOptions.Alignments}"
                                  SelectedValue="{Binding LyricsAlign}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_Lyr_GroupEffects}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE945;" Header="{l:Tr Set_LyricEffect}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox MinWidth="260" DisplayMemberPath="Label" SelectedValuePath="Value" ItemsSource="{x:Static v:SettingsOptions.LyricEffects}"
                                      SelectedValue="{Binding LyricEffect}"
                                      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <Button Content="{l:Tr Set_Preview}" Margin="8,0,0,0" Padding="14,5" Click="PreviewEffect_Click" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xEC4A;" Header="{l:Tr Set_AnimSpeed}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="0.5" Maximum="2" SmallChange="0.1" LargeChange="0.25"
                                    Value="{Binding AnimationSpeed}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AnimationSpeed, StringFormat={}{0:0.0}×}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE7E6;" Header="{l:Tr Set_Karaoke}"
                                   Description="{l:Tr Set_Karaoke_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Karaoke}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8FD;" Header="{l:Tr Set_NextLine}" Description="{l:Tr Set_NextLine_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowNextLine}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE916;" Header="{l:Tr Set_Offset}"
                                   Description="{l:Tr Set_Offset_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="-3000" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"
                                    Value="{Binding LyricsDelayMs}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LyricsDelayMs, StringFormat={}{0:+0;-0;0} ms}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8C1;" Header="{l:Tr Set_Romanization}" Description="{l:Tr Set_Romanization_Desc}">
                        <ComboBox MinWidth="200" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  ItemsSource="{x:Static v:SettingsOptions.Romanizations}" SelectedValue="{Binding Romanization}"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8BC;" Header="{l:Tr Set_LyricsPanel}" Description="{l:Tr Set_LyricsPanel_Desc}" />

                    <TextBlock Text="{l:Tr Set_Lyr_GroupText}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE8D2;" Header="{l:Tr Set_Font}"
                                   Description="{l:Tr Set_Font_Desc}">
                        <ComboBox x:Name="FontCombo" MinWidth="260" SelectedItem="{Binding FontFamily}" MaxDropDownHeight="420"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}">
                            <ComboBox.Resources>
                                <v:FontPreviewConverter x:Key="FontPreview" />
                            </ComboBox.Resources>
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding Converter={StaticResource FontPreview}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8E9;" Header="{l:Tr Set_LyricScale}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="0.6" Maximum="2" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding LyricScale}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LyricScale, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE790;" Header="{l:Tr Set_LyricColor}"
                                   Description="{l:Tr Set_LyricColor_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{x:Static v:SettingsOptions.LyricSwatches}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Swatch}" Background="{Binding}" Tag="{Binding}"
                                                Click="LyricSwatch_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Width="92" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Text="{Binding LyricColor, UpdateSourceTrigger=LostFocus}" KeyDown="ColorBox_KeyDown"
                                     AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE793;" Header="{l:Tr Set_LyricOpacity}" Description="{l:Tr Set_LyricOpacity_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="0.2" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                                    Value="{Binding LyricOpacity}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LyricOpacity, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8E5;" Header="{l:Tr Set_Stroke}"
                                   Description="{l:Tr Set_Stroke_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LyricStroke}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE790;" Header="{l:Tr Set_StrokeColor}" IsEnabled="{Binding LyricStroke}">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{x:Static v:SettingsOptions.StrokeSwatches}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Swatch}" Background="{Binding}" Tag="{Binding}"
                                                Click="StrokeSwatch_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Width="92" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Text="{Binding LyricStrokeColor, UpdateSourceTrigger=LostFocus}" KeyDown="ColorBox_KeyDown"
                                     AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE793;" Header="{l:Tr Set_StrokeOpacity}" IsEnabled="{Binding LyricStroke}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                                    Value="{Binding LyricStrokeOpacity}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LyricStrokeOpacity, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE740;" Header="{l:Tr Set_StrokeRadius}" IsEnabled="{Binding LyricStroke}"
                                   Description="{l:Tr Set_StrokeRadius_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" Minimum="1" Maximum="24" SmallChange="1" LargeChange="2"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding LyricStrokeRadius}" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LyricStrokeRadius, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_Lyr_GroupSource}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE8D6;" Header="{l:Tr Set_LyricsEnabled}" Description="{l:Tr Set_LyricsEnabled_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LyricsEnabled}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE774;" Header="{l:Tr Set_FetchOnline}" Description="{l:Tr Set_FetchOnline_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FetchOnline}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8F1;" Header="{l:Tr Set_NetEase}" Description="{l:Tr Set_NetEase_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LyricsFromNetEase}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE968;" Header="{l:Tr Set_Proxy}" Description="{l:Tr Set_Proxy_Desc}">
                        <TextBox Width="260" Text="{Binding ProxyUrl, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource AncestorType=v:SettingCard}}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE8B7;" Header="{l:Tr Set_LyricsFolder}"
                                   Description="{l:Tr Set_LyricsFolder_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Tr Set_Open}" Padding="14,5" Click="OpenLyricsFolder_Click" />
                            <Button Content="{l:Tr Set_Change}" Padding="14,5" Margin="6,0,0,0" Click="ChangeLyricsFolder_Click" />
                            <Button Content="{l:Tr Set_Default}" Padding="14,5" Margin="6,0,0,0" Click="ResetLyricsFolder_Click" />
                        </StackPanel>
                    </v:SettingCard>
                    <TextBlock x:Name="LyricsFolderText" FontSize="12" Opacity="0.55" Margin="18,-2,0,8" TextTrimming="CharacterEllipsis" />
                    <v:SettingCard x:Name="CacheCard" Glyph="&#xE74D;" Header="{l:Tr Set_Cache}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Tr Set_RetryMisses}" Padding="14,5" Click="ClearMisses_Click" />
                            <Button Content="{l:Tr Set_ClearDownloaded}" Padding="14,5" Margin="6,0,0,0" Click="ClearDownloaded_Click" />
                        </StackPanel>
                    </v:SettingCard>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="{l:Tr Set_Page_About}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:Tr Set_About_Subtitle}" Style="{StaticResource PageSubtitle}" />

                    <Border CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="22">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/MusicBar.ico" Width="64" Height="64"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MusicBar" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutVersion" Opacity="0.6" Margin="0,2,0,0" />
                                <TextBlock Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap">
                                    <Run Text="{l:Tr Set_About_Lyrics}" /> <Hyperlink NavigateUri="https://lrclib.net" RequestNavigate="Link_RequestNavigate">LRCLIB</Hyperlink> · <Run Text="{l:Tr Set_About_Media}" /> Windows Media Session
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:Tr Set_About_GroupTips}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE7F4;" Header="{l:Tr Set_Tip_Bar}"
                                   Description="{l:Tr Set_Tip_Bar_Desc}" />
                    <v:SettingCard Glyph="&#xE712;" Header="{l:Tr Set_Tip_RightClick}"
                                   Description="{l:Tr Set_Tip_RightClick_Desc}" />
                    <v:SettingCard Glyph="&#xE8A7;" Header="{l:Tr Set_Tip_ClickCover}" Description="{l:Tr Set_Tip_ClickCover_Desc}" />

                    <v:SettingCard Glyph="&#xE7BE;" Header="{l:Tr Set_Tour}" Description="{l:Tr Set_Tour_Desc}">
                        <Button Content="{l:Tr Set_TourButton}" Padding="14,5" Click="Tour_Click" />
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_About_GroupUpdates}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE895;" Header="{l:Tr Set_CheckUpdates}" Description="{l:Tr Set_CheckUpdates_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}" />
                    </v:SettingCard>
                    <v:SettingCard x:Name="UpdateCard" Glyph="&#xE72C;" Header="{l:Tr Set_CheckNow}">
                        <Button x:Name="CheckNowButton" Content="{l:Tr Set_CheckNowButton}" Padding="14,5" Click="CheckNow_Click" />
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_About_GroupRecap}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE9D2;" Header="{l:Tr Set_KeepStats}" Description="{l:Tr Set_KeepStats_Desc}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepListeningStats}" />
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE734;" Header="{l:Tr Set_Recap}" Description="{l:Tr Set_Recap_Desc}">
                        <Button Content="{l:Tr Set_RecapButton}" Padding="14,5" Click="Recap_Click" />
                    </v:SettingCard>

                    <TextBlock Text="{l:Tr Set_About_GroupData}" Style="{StaticResource Group}" />
                    <v:SettingCard Glyph="&#xE8B7;" Header="{l:Tr Set_DataFolder}" Description="{l:Tr Set_DataFolder_Desc}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Tr Set_OpenFolder}" Padding="14,5" Click="OpenDataFolder_Click" />
                            <Button Content="{l:Tr Set_ViewLog}" Padding="14,5" Margin="6,0,0,0" Click="OpenLog_Click" />
                        </StackPanel>
                    </v:SettingCard>
                    <v:SettingCard Glyph="&#xE777;" Header="{l:Tr Set_Reset}" Description="{l:Tr Set_Reset_Desc}">
                        <Button Content="{l:Tr Set_ResetButton}" Padding="14,5" Click="Reset_Click" />
                    </v:SettingCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </Grid>
    </Grid>
</Window>
