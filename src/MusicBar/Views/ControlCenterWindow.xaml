<Window x:Class="MusicBar.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        Title="MusicBar Control Center"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Left="-20000" Top="-20000" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFF6B6B" />
        <!-- Text and ticks drawn on the accent: dark on a light accent, white on a deep one. -->
        <SolidColorBrush x:Key="OnAccent" Color="#FF101014" />
        <SolidColorBrush x:Key="CardBackground" Color="#F5141418" />
        <SolidColorBrush x:Key="CardBorder" Color="#24FFFFFF" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.5" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon button (mute). -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="36" Height="36" CornerRadius="18" Background="#0FFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource IconFont}" TextElement.FontSize="16" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-width row button (output device, device list entries). -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick setting tile: filled with the accent while switched on. -->
        <SolidColorBrush x:Key="TileIdle" Color="#14FFFFFF" />
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="#1AFFFFFF" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="8" Background="White" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.03" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text button ("Xóa tất cả", footer). -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider: a 4 px track filled with the accent and a ringed thumb. -->
        <Style x:Key="TrackPart" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="#01FFFFFF">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20">
                            <Ellipse Fill="#FF3A3A40" Stroke="#30FFFFFF" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="12" />
                                <Setter TargetName="Dot" Property="Height" Value="12" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="9" />
                                <Setter TargetName="Dot" Property="Height" Value="9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="2" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32" Background="#01FFFFFF">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackPart}" Command="Slider.DecreaseLarge" Background="{DynamicResource Accent}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackPart}" Command="Slider.IncreaseLarge" Background="#33FFFFFF" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VolumeThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One half of a split tile (Wi-Fi, Bluetooth): the tile behind carries the color, this only the
             hover. Tag holds the CornerRadius of its side. -->
        <Style x:Key="TilePart" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="#01FFFFFF">
                            <Border x:Name="Hover" Background="White" Opacity="0"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.03" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons inside the side lists: the main action in the accent, the others quiet. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Body">
                            <Border CornerRadius="7" Background="{DynamicResource Accent}" />
                            <Border x:Name="Hover" CornerRadius="7" Background="White" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.05" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="#1AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text fields (network key, user name, PIN): dark, outlined in the accent while typing. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyField" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="7" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="#80FFFFFF" Background="#0AFFFFFF">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The outer margin leaves room for the shadows. -->
    <Grid x:Name="Root" Margin="18,14,18,22" Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="372" />
        </Grid.ColumnDefinitions>

        <!-- Lists (playback devices, display modes, wireless displays) slide out beside the
             controls instead of replacing them with a sub-page: to their left, or to their
             right beside a taskbar on the screen's left (Mirror swaps the columns). -->
        <Border x:Name="Side" Style="{StaticResource Card}" VerticalAlignment="Bottom"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SideShift" X="28" />
            </Border.RenderTransform>
            <StackPanel Margin="6,8,6,6">
                <Grid Margin="10,4,2,8" MinHeight="22">
                    <TextBlock x:Name="SideTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <!-- Header tools, such as "look again". -->
                    <StackPanel x:Name="SideTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer x:Name="SideScroll" MaxHeight="430" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="SideList" />
                </ScrollViewer>
                <!-- A link to the matching Windows settings page. -->
                <StackPanel x:Name="SideFooter" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="Main" Grid.Column="2" VerticalAlignment="Bottom">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="MainShift" />
            </StackPanel.RenderTransform>

            <!-- Notifications -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Border CornerRadius="14" ClipToBounds="True">
                        <Border.Background>
                            <RadialGradientBrush Center="0.08,0" GradientOrigin="0.08,0" RadiusX="0.85" RadiusY="0.9">
                                <GradientStop x:Name="NotificationWash" Color="#22FF6B6B" Offset="0" />
                                <GradientStop Color="#00FF6B6B" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="8,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr CC_Notifications}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border x:Name="CountChip" Grid.Column="1" CornerRadius="8" Background="{DynamicResource Accent}"
                                    Padding="6,0,6,1" Margin="8,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="CountText" FontSize="11" FontWeight="SemiBold" Foreground="#FF101014" />
                            </Border>
                            <Button x:Name="ClearAllButton" Grid.Column="2" Style="{StaticResource TextButton}" Click="ClearAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr CC_ClearAll}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer x:Name="NotificationScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="NotificationList" />
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" Grid.Row="1" Margin="0,14,0,18" HorizontalAlignment="Center">
                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="22" Opacity="0.35"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyText" FontSize="12" Opacity="0.5"
                                       Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Controls -->
            <Border Style="{StaticResource Card}">
                <StackPanel Margin="14,14,14,10">
                    <UniformGrid x:Name="TileGrid" Columns="3" Margin="-4,0,-4,4" />
                    <!-- Brightness, as Windows' Quick Settings has it: a laptop's own panel, or monitors
                         that take DDC/CI. Only shown when there is something to dim; the wheel works on it too. -->
                    <Grid x:Name="BrightnessRow" Background="Transparent" Margin="0,0,0,4" Visibility="Collapsed"
                          MouseWheel="Brightness_MouseWheel" ToolTip="{l:Tr CC_Brightness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36">
                            <TextBlock x:Name="BrightnessGlyph" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="BrightnessTurn" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="12,0,10,0"
                                Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Brightness_Changed"
                                AutomationProperties.Name="{l:Tr CC_Brightness}" />
                        <TextBlock x:Name="BrightnessText" Grid.Column="2" FontSize="13" MinWidth="26" TextAlignment="Right"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,4,1" />
                    </Grid>
                    <!-- The wheel anywhere on the volume row moves the volume. -->
                    <Grid Background="Transparent" MouseWheel="Volume_MouseWheel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Click="Mute_Click" ToolTip="{l:Tr CC_Mute}"
                                AutomationProperties.Name="{l:Tr CC_Mute}">
                            <TextBlock x:Name="VolumeGlyph" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Margin="12,0,10,0"
                                VerticalAlignment="Center" ValueChanged="Volume_Changed"
                                AutomationProperties.Name="{l:Tr A11y_Volume}" />
                        <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="13" MinWidth="26" TextAlignment="Right"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,4,1" />
                    </Grid>

                    <Button x:Name="OutputButton" Style="{StaticResource RowButton}" Margin="-4,8,-4,2" Click="Output_Click"
                            ToolTip="{l:Tr CC_ChooseOutput}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OutputChevron" Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="OutputName" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OutputAdapter" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="OutputGlyph" Grid.Column="2" Text="&#xE7F5;" FontFamily="{StaticResource IconFont}"
                                       FontSize="16" Opacity="0.85" VerticalAlignment="Center" Margin="10,0,2,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
