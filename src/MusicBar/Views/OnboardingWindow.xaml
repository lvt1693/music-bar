<Window x:Class="MusicBar.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        Title="{l:Tr Wel_Window}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Width="928" Height="676" UseLayoutRounding="True" Foreground="#F4FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Assets/MusicBar.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFF6B6B" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
        <!-- MusicBar's own sunset: coral into amber, the colors of the bar on its first day. -->
        <LinearGradientBrush x:Key="Signature" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF5F6D" Offset="0" />
            <GradientStop Color="#FFFFC371" Offset="1" />
        </LinearGradientBrush>

        <!-- A slim slider: a hairline track, the part behind the thumb in the signature colors. -->
        <Style x:Key="Slim" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#26FFFFFF" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Signature}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#FFFF6B6B" Opacity="0.7" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow; the shadow sits on its own, so the text above stays sharp. -->
    <Grid Margin="24">
        <Border CornerRadius="18" Background="#FA0F0F13" BorderBrush="#22FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Inside">
            <!-- Two slow glows in the signature colors, drifting behind everything. -->
            <Canvas x:Name="Glows" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <!-- Header: the name, the steps as a little seekbar, the language and a way out. -->
                <Grid x:Name="Header" Margin="28,0,18,0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/MusicBar.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="MusicBar" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Progress" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock x:Name="StepLabel" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <Grid x:Name="Seek" Height="12">
                            <Border Height="3" CornerRadius="1.5" Background="#1FFFFFFF" VerticalAlignment="Center" />
                            <Border x:Name="SeekFill" Height="3" CornerRadius="1.5" Background="{StaticResource Signature}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                            <Canvas x:Name="SeekDots" />
                            <Ellipse x:Name="SeekHead" Width="11" Height="11" Fill="#FFFFC371" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FFFF8A5B" Opacity="0.95" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="#12FFFFFF" Padding="2">
                            <StackPanel x:Name="Languages" Orientation="Horizontal" />
                        </Border>
                        <Button x:Name="CloseButton" Style="{StaticResource CardIconButton}" Margin="10,0,0,0" Click="Close_Click"
                                ToolTip="{l:Tr Wel_Close}">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Each step comes in here. -->
                <ContentControl x:Name="Stage" Grid.Row="1" Margin="48,4,48,0" Focusable="False" />

                <!-- Footer: a way out, where this lives in the settings, and on. -->
                <Grid x:Name="Footer" Grid.Row="2" Margin="40,12,40,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SkipButton" Style="{StaticResource CardLinkButton}" Click="Skip_Click" VerticalAlignment="Center" />
                    <Border x:Name="WherePill" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
                            Background="#10FFFFFF" Padding="11,5,13,5" Margin="12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81D;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#FFFFC371"
                                       VerticalAlignment="Center" Margin="0,1,7,0" />
                            <TextBlock x:Name="WhereText" FontSize="11.5" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource CardSoftButton}" Padding="16,8" Click="Back_Click" />
                        <Button x:Name="NextButton" Style="{StaticResource CardAccentButton}" Padding="22,8" Margin="8,0,0,0" Click="Next_Click" />
                    </StackPanel>
                </Grid>

                <!-- MusicBar's signature: the taskbar in miniature, wearing every choice the moment it is made. -->
                <Grid x:Name="Strip" Grid.Row="3" ClipToBounds="True" />
            </Grid>
        </Grid>
    </Grid>
</Window>
