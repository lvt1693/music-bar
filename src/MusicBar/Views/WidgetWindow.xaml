<Window x:Class="MusicBar.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MusicBar.Views"
        xmlns:l="clr-namespace:MusicBar.Infrastructure"
        Title="MusicBar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Left="-20000" Top="-20000" Width="600" Height="30"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- No background here: the unused part of the window lets clicks through to the taskbar. -->
    <Grid x:Name="Root">
        <Border x:Name="Pill" HorizontalAlignment="Right" Margin="0,2" Background="#01FFFFFF"
                MouseRightButtonUp="Pill_MouseRightButtonUp">
            <!-- Lyrics, cover and buttons sit in a row across a horizontal taskbar and in a
                 column down a vertical one (SetLayout picks the cells). -->
            <Grid x:Name="PillGrid" Margin="3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Fills the pill, so the row's content sits in the taskbar's middle (Arrange swaps it for a vertical taskbar). -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- A click opens the whole song's lyrics; the wheel moves them earlier or later. -->
                <Border x:Name="LyricsHost" Grid.Column="0" Width="0" Opacity="0" ClipToBounds="True"
                        Background="#01FFFFFF" Cursor="Hand"
                        MouseLeftButtonUp="Lyrics_MouseLeftButtonUp" MouseWheel="Lyrics_MouseWheel">
                    <Grid>
                        <v:LyricsPresenter x:Name="LineLyrics" Margin="10,0,6,0" IsHitTestVisible="False" />
                        <v:WordStackPresenter x:Name="StackLyrics" Margin="0,8,0,6" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Button x:Name="CoverButton" Grid.Column="1" Style="{StaticResource BareButton}" Padding="3,0"
                        VerticalAlignment="Center" Click="Cover_Click" AutomationProperties.Name="{l:Tr Set_LyricsExpanded}"
                        MouseEnter="Cover_MouseEnter" MouseLeave="Cover_MouseLeave">
                    <Grid x:Name="ArtHost" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ArtScale" />
                        </Grid.RenderTransform>
                        <Border x:Name="ArtPlaceholder" CornerRadius="5" Background="#24FFFFFF">
                            <Grid>
                                <Image x:Name="ArtAppIcon" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="ArtGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="#B3FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="ArtA" CornerRadius="5" Opacity="0">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrushA" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="ArtB" CornerRadius="5" Opacity="0">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrushB" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="ArtStroke" CornerRadius="5" BorderBrush="#2EFFFFFF" BorderThickness="0.8" />
                        <Border x:Name="ArtOverlay" CornerRadius="5" Background="#99000000" Opacity="0">
                            <TextBlock x:Name="ArtOverlayGlyph" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="AppBadge" Width="12" Height="12" CornerRadius="3" Background="#F2141418"
                                BorderBrush="#33FFFFFF" BorderThickness="0.5" Padding="1"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-3"
                                Visibility="Collapsed">
                            <Image x:Name="AppBadgeImage" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Grid>
                </Button>

                <!-- The shell is only drawn by the capsule style: one glass pill around all three buttons. -->
                <Border x:Name="ControlsShell" Grid.Column="2" VerticalAlignment="Center" Margin="2,0,1,0">
                <StackPanel x:Name="Controls" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Click="Prev_Click"
                            AutomationProperties.Name="{l:Tr A11y_Prev}">
                        <Viewbox x:Name="PrevIcon" Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="PrevPath" Data="{StaticResource GlyphPrevious}" Fill="White">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="PrevShift" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="3,0" Click="Play_Click"
                            AutomationProperties.Name="{l:Tr A11y_PlayPause}">
                        <Viewbox x:Name="PlayIconBox" Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="PlayGlyph" Data="{StaticResource GlyphPlay}">
                                    <Path.RenderTransform>
                                        <ScaleTransform CenterX="12" CenterY="12" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path x:Name="PauseGlyph" Data="{StaticResource GlyphPause}" Opacity="0">
                                    <Path.RenderTransform>
                                        <ScaleTransform CenterX="12" CenterY="12" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Click="Next_Click"
                            AutomationProperties.Name="{l:Tr A11y_Next}">
                        <Viewbox x:Name="NextIcon" Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="NextPath" Data="{StaticResource GlyphNext}" Fill="White">
                                    <Path.RenderTransform>
                                        <TranslateTransform x:Name="NextShift" />
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
